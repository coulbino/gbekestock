<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GbêkêStock — Gestion de Stock Commerçants de Bouaké</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            brand: {
              50: '#eff6ff',
              100: '#dbeafe',
              500: '#3b82f6',
              600: '#2563eb',
              700: '#1d4ed8',
            }
          }
        }
      }
    }
  </script>
  <style>
    body {
      font-family: 'Inter', sans-serif;
      -webkit-tap-highlight-color: transparent;
    }
    .row-transition {
      transition: background-color 0.25s ease, transform 0.2s ease, opacity 0.2s ease;
    }
    @keyframes pulse-once {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.04); }
    }
    .stat-bump {
      animation: pulse-once 0.25s ease-out;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">
  <!-- Top Navigation Bar -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-xs">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-brand-600 flex items-center justify-center text-white shadow-sm shadow-brand-500/30">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-lg sm:text-xl font-bold tracking-tight text-slate-900">GbêkêStock</h1>
            <span class="hidden sm:inline-block text-xs font-medium px-2 py-0.5 rounded-full bg-brand-50 text-brand-700 border border-brand-100">
              Bouaké Commerce
            </span>
          </div>
          <p class="text-xs text-slate-500">Gestion d'inventaire en temps réel</p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <span id="live-status" class="inline-flex items-center gap-1.5 text-xs font-medium text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-1 rounded-full">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Actif
        </span>
      </div>
    </div>
  </header>
  <!-- Main Content -->
  <main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 space-y-6 sm:space-y-8">
    <!-- 1. TABLEAU DE BORD (3 Cartes Statistiques) -->
    <section aria-label="Statistiques du stock">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-5">
        
        <!-- Carte 1 : Total des références -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs flex items-center justify-between transition-all hover:shadow-md">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Total des références</p>
            <p id="stat-total-refs" class="text-2xl sm:text-3xl font-bold text-slate-900 mt-1">0</p>
            <p id="stat-total-units" class="text-xs text-slate-500 mt-1">0 unité(s) en magasin</p>
          </div>
          <div class="w-12 h-12 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
        </div>
        <!-- Carte 2 : Valeur totale du stock (FCFA) -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs flex items-center justify-between transition-all hover:shadow-md">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Valeur totale du stock</p>
            <p id="stat-total-value" class="text-2xl sm:text-3xl font-bold text-brand-600 mt-1">0 FCFA</p>
            <p class="text-xs text-slate-500 mt-1">Valorisation cumulée</p>
          </div>
          <div class="w-12 h-12 rounded-xl bg-blue-50 text-brand-600 flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
        </div>
        <!-- Carte 3 : Produits en rupture -->
        <div id="card-out-of-stock" class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs flex items-center justify-between transition-all hover:shadow-md">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Produits en rupture</p>
            <p id="stat-out-of-stock" class="text-2xl sm:text-3xl font-bold text-slate-900 mt-1">0</p>
            <p id="stat-out-subtitle" class="text-xs text-slate-500 mt-1">Réapprovisionnement requis</p>
          </div>
          <div id="icon-out-of-stock" class="w-12 h-12 rounded-xl bg-slate-100 text-slate-600 flex items-center justify-center shrink-0 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
        </div>
      </div>
    </section>
    <!-- 2. ZONE D'ACTION : Formulaire d'ajout de produit -->
    <section aria-label="Ajouter un nouvel article" class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-5 sm:p-6">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 class="text-base sm:text-lg font-bold text-slate-900">Nouvel arrivage / Ajouter un article</h2>
          <p class="text-xs sm:text-sm text-slate-500">Enregistrez rapidement un produit dans votre inventaire</p>
        </div>
      </div>
      <form id="add-product-form" class="grid grid-cols-1 sm:grid-cols-12 gap-4 items-end">
        <!-- Nom du produit -->
        <div class="sm:col-span-5">
          <label for="product-name" class="block text-xs font-semibold text-slate-700 mb-1.5">
            Nom du produit <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="product-name"
            required
            placeholder="Ex: Sac de Riz Local 25kg, Huile Dinor 5L..."
            class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-300 bg-slate-50/50 text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-600 transition"
          />
        </div>
        <!-- Quantité -->
        <div class="sm:col-span-2">
          <label for="product-qty" class="block text-xs font-semibold text-slate-700 mb-1.5">
            Quantité <span class="text-red-500">*</span>
          </label>
          <input
            type="number"
            id="product-qty"
            required
            min="0"
            step="1"
            placeholder="Ex: 15"
            class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-300 bg-slate-50/50 text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-600 transition"
          />
        </div>
        <!-- Prix unitaire -->
        <div class="sm:col-span-3">
          <label for="product-price" class="block text-xs font-semibold text-slate-700 mb-1.5">
            Prix unitaire (FCFA) <span class="text-red-500">*</span>
          </label>
          <div class="relative">
            <input
              type="number"
              id="product-price"
              required
              min="1"
              step="5"
              placeholder="Ex: 12500"
              class="w-full pl-3.5 pr-14 py-2.5 text-sm rounded-xl border border-slate-300 bg-slate-50/50 text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-600 transition"
            />
            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-semibold text-slate-400 pointer-events-none">
              FCFA
            </span>
          </div>
        </div>
        <!-- Bouton Ajouter au stock -->
        <div class="sm:col-span-2">
          <button
            type="submit"
            class="w-full py-2.5 px-4 rounded-xl bg-brand-600 hover:bg-brand-700 active:scale-[0.99] text-white font-semibold text-sm shadow-sm shadow-brand-500/20 flex items-center justify-center gap-2 transition cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            <span>Ajouter au stock</span>
          </button>
        </div>
      </form>
    </section>
    <!-- 3. TABLEAU D'INVENTAIRE -->
    <section aria-label="Inventaire des produits" class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden">
      <!-- En-tête de liste + Recherche rapide -->
      <div class="p-5 sm:p-6 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <h2 class="text-base sm:text-lg font-bold text-slate-900">Inventaire des marchandises</h2>
          <p class="text-xs sm:text-sm text-slate-500">Cliquez sur « Vendre 1 article » à chaque vente au comptoir</p>
        </div>
        <!-- Barre de filtre rapide -->
        <div class="relative w-full sm:w-64">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="search"
            id="search-input"
            placeholder="Rechercher un article..."
            class="w-full pl-9 pr-3.5 py-2 text-xs sm:text-sm rounded-xl border border-slate-200 bg-slate-50 text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-600 transition"
          />
        </div>
      </div>
      <!-- Tableau responsive -->
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50/80 border-b border-slate-200 text-[11px] font-semibold uppercase tracking-wider text-slate-500">
              <th class="py-3.5 pl-5 pr-3">Article</th>
              <th class="py-3.5 px-3 text-center">État / Quantité</th>
              <th class="py-3.5 px-3 text-right">Prix Unitaire</th>
              <th class="py-3.5 px-3 text-right hidden md:table-cell">Valeur Stock</th>
              <th class="py-3.5 pl-3 pr-5 text-right">Actions rapides</th>
            </tr>
          </thead>
          <tbody id="inventory-tbody" class="divide-y divide-slate-200/70 text-sm">
            <!-- Injecté dynamiquement par JavaScript -->
          </tbody>
        </table>
      </div>
      <!-- État vide -->
      <div id="empty-state" class="hidden py-12 px-4 text-center">
        <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 mx-auto flex items-center justify-center mb-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
          </svg>
        </div>
        <p class="text-sm font-semibold text-slate-700">Aucun produit trouvé dans l'inventaire</p>
        <p class="text-xs text-slate-500 mt-1">Utilisez le formulaire ci-dessus pour ajouter votre premier article.</p>
      </div>
    </section>
  </main>
  <!-- Notification Toast Flottante -->
  <div id="toast-container" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 pointer-events-none"></div>
  <!-- Footer -->
  <footer class="max-w-6xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-5 text-center text-xs text-slate-400 border-t border-slate-200/60 mt-auto">
    GbêkêStock • Solution de gestion pensée pour les commerçants de Bouaké (Marché Central, Koko, Air France, Dar-es-Salam)
  </footer>
  <!-- LOGIQUE JAVASCRIPT VANILLA -->
  <script>
    // --- 1. JEU DE DONNÉES INITIAL (Produits courants à Bouaké) ---
    let products = [
      {
        id: 1,
        name: "Sac de Riz Local Bouaké (25 kg)",
        quantity: 14,
        price: 13500
      },
      {
        id: 2,
        name: "Bidon d'Huile Dinor (5 Litres)",
        quantity: 6,
        price: 6500
      },
      {
        id: 3,
        name: "Carton de Savon BF (36 morceaux)",
        quantity: 1,
        price: 9000
      },
      {
        id: 4,
        name: "Sac d'Oignons du Nord (25 kg)",
        quantity: 0,
        price: 18000
      }
    ];
    let searchQuery = "";
    // --- 2. UTILITAIRES DE FORMATAGE ---
    function formatFCFA(amount) {
      return new Intl.NumberFormat('fr-FR').format(amount) + ' FCFA';
    }
    function escapeHTML(str) {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }
    // --- 3. NOTIFICATIONS TOAST FLUIDES ---
    function showToast(message, type = 'info') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      
      const styles = {
        success: 'bg-slate-900 text-white border-slate-800',
        warning: 'bg-red-600 text-white border-red-700',
        info: 'bg-brand-600 text-white border-brand-700'
      };
      toast.className = `${styles[type] || styles.info} px-4 py-2.5 rounded-xl shadow-lg border text-xs sm:text-sm font-medium flex items-center gap-2 transition-all duration-300 opacity-0 translate-y-2`;
      toast.innerHTML = `<span>${escapeHTML(message)}</span>`;
      container.appendChild(toast);
      requestAnimationFrame(() => {
        toast.classList.remove('opacity-0', 'translate-y-2');
      });
      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 2400);
    }
    // --- 4. MISE À JOUR DES STATISTIQUES (TEMPS RÉEL) ---
    function updateStats() {
      const totalRefs = products.length;
      const totalUnits = products.reduce((sum, item) => sum + item.quantity, 0);
      const totalValue = products.reduce((sum, item) => sum + (item.quantity * item.price), 0);
      const outOfStockCount = products.filter(item => item.quantity === 0).length;
      const elRefs = document.getElementById('stat-total-refs');
      const elUnits = document.getElementById('stat-total-units');
      const elValue = document.getElementById('stat-total-value');
      const elOut = document.getElementById('stat-out-of-stock');
      const elOutSubtitle = document.getElementById('stat-out-subtitle');
      const cardOut = document.getElementById('card-out-of-stock');
      const iconOut = document.getElementById('icon-out-of-stock');
      elRefs.textContent = totalRefs;
      elUnits.textContent = `${new Intl.NumberFormat('fr-FR').format(totalUnits)} unité${totalUnits > 1 ? 's' : ''} en magasin`;
      elValue.textContent = formatFCFA(totalValue);
      elOut.textContent = outOfStockCount;
      // Animation légère au changement
      [elRefs, elValue, elOut].forEach(el => {
        el.classList.remove('stat-bump');
        void el.offsetWidth;
        el.classList.add('stat-bump');
      });
      // Style dynamique de la carte Rupture de stock
      if (outOfStockCount > 0) {
        elOut.className = "text-2xl sm:text-3xl font-bold text-red-600 mt-1 stat-bump";
        elOutSubtitle.textContent = `${outOfStockCount} article${outOfStockCount > 1 ? 's' : ''} à commander`;
        elOutSubtitle.className = "text-xs text-red-600 font-medium mt-1";
        cardOut.className = "bg-red-50/40 rounded-2xl p-5 border border-red-200 shadow-xs flex items-center justify-between transition-all";
        iconOut.className = "w-12 h-12 rounded-xl bg-red-100 text-red-600 flex items-center justify-center shrink-0 transition-colors";
      } else {
        elOut.className = "text-2xl sm:text-3xl font-bold text-emerald-600 mt-1 stat-bump";
        elOutSubtitle.textContent = "Tout le stock est disponible";
        elOutSubtitle.className = "text-xs text-emerald-600 font-medium mt-1";
        cardOut.className = "bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs flex items-center justify-between transition-all";
        iconOut.className = "w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 transition-colors";
      }
    }
    // --- 5. RENDU DU TABLEAU D'INVENTAIRE ---
    function renderInventory() {
      const tbody = document.getElementById('inventory-tbody');
      const emptyState = document.getElementById('empty-state');
      const filteredProducts = products.filter(p =>
        p.name.toLowerCase().includes(searchQuery.toLowerCase())
      );
      if (filteredProducts.length === 0) {
        tbody.innerHTML = '';
        emptyState.classList.remove('hidden');
        return;
      }
      emptyState.classList.add('hidden');
      tbody.innerHTML = filteredProducts.map(product => {
        const isOutOfStock = product.quantity === 0;
        const isLowStock = product.quantity > 0 && product.quantity <= 3;
        const lineValue = product.quantity * product.price;
        // Fond rouge très clair lorsque le stock atteint zéro
        const rowBgClass = isOutOfStock
          ? 'bg-red-50/90 hover:bg-red-100/70'
          : 'bg-white hover:bg-slate-50/80';
        // Badge d'état
        let statusBadge = '';
        if (isOutOfStock) {
          statusBadge = `
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-700 border border-red-200">
              <span class="w-1.5 h-1.5 rounded-full bg-red-600"></span>
              Rupture de stock
            </span>
          `;
        } else if (isLowStock) {
          statusBadge = `
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
              ${product.quantity} en stock (Faible)
            </span>
          `;
        } else {
          statusBadge = `
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              ${product.quantity} en stock
            </span>
          `;
        }
        return `
          <tr class="row-transition ${rowBgClass}" data-id="${product.id}">
            <!-- Nom du produit + Sous-info mobile -->
            <td class="py-4 pl-5 pr-3 align-middle">
              <div class="font-semibold ${isOutOfStock ? 'text-red-900' : 'text-slate-900'}">
                ${escapeHTML(product.name)}
              </div>
              <div class="text-xs text-slate-500 md:hidden mt-0.5">
                Valeur : <span class="font-medium text-slate-700">${formatFCFA(lineValue)}</span>
              </div>
            </td>
            <!-- Quantité / Badge -->
            <td class="py-4 px-3 text-center align-middle whitespace-nowrap">
              ${statusBadge}
            </td>
            <!-- Prix Unitaire -->
            <td class="py-4 px-3 text-right align-middle font-medium text-slate-700 whitespace-nowrap">
              ${formatFCFA(product.price)}
            </td>
            <!-- Valeur Totale Ligne (Desktop) -->
            <td class="py-4 px-3 text-right align-middle font-semibold text-slate-900 hidden md:table-cell whitespace-nowrap">
              ${formatFCFA(lineValue)}
            </td>
            <!-- Boutons d'action -->
            <td class="py-4 pl-3 pr-5 text-right align-middle whitespace-nowrap">
              <div class="inline-flex items-center justify-end gap-2">
                <!-- Bouton Vendre 1 article -->
                <button
                  type="button"
                  onclick="sellOneItem(${product.id})"
                  ${isOutOfStock ? 'disabled' : ''}
                  class="px-3 py-1.5 rounded-lg text-xs font-semibold transition flex items-center gap-1.5 ${
                    isOutOfStock
                      ? 'bg-slate-200/70 text-slate-400 cursor-not-allowed'
                      : 'bg-brand-50 text-brand-700 hover:bg-brand-600 hover:text-white border border-brand-200 hover:border-brand-600 active:scale-95 cursor-pointer shadow-2xs'
                  }"
                  title="${isOutOfStock ? 'Stock épuisé' : 'Décrémenter le stock de 1'}"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                  </svg>
                  <span>Vendre 1 article</span>
                </button>
                <!-- Bouton Suppression -->
                <button
                  type="button"
                  onclick="deleteProduct(${product.id})"
                  class="p-2 rounded-lg text-slate-400 hover:text-red-600 hover:bg-red-50 transition active:scale-95 cursor-pointer"
                  title="Supprimer cet article"
                  aria-label="Supprimer ${escapeHTML(product.name)}"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                </button>
              </div>
            </td>
          </tr>
        `;
      }).join('');
    }
    // --- 6. ACTIONS MÉTIER ---
    // Vendre 1 article (décrémente instantanément)
    window.sellOneItem = function(id) {
      const product = products.find(p => p.id === id);
      if (!product || product.quantity <= 0) return;
      product.quantity -= 1;
      updateStats();
      renderInventory();
      if (product.quantity === 0) {
        showToast(`⚠️ Rupture de stock : "${product.name}" est épuisé !`, 'warning');
      } else {
        showToast(`✅ 1 "${product.name}" vendu (${formatFCFA(product.price)})`, 'success');
      }
    };
    // Supprimer un article
    window.deleteProduct = function(id) {
      const product = products.find(p => p.id === id);
      if (!product) return;
      products = products.filter(p => p.id !== id);
      updateStats();
      renderInventory();
      showToast(`🗑️ "${product.name}" retiré de l'inventaire`, 'info');
    };
    // Ajouter un nouvel article via le formulaire
    document.getElementById('add-product-form').addEventListener('submit', function(e) {
      e.preventDefault();
      const nameInput = document.getElementById('product-name');
      const qtyInput = document.getElementById('product-qty');
      const priceInput = document.getElementById('product-price');
      const name = nameInput.value.trim();
      const quantity = parseInt(qtyInput.value, 10);
      const price = parseInt(priceInput.value, 10);
      if (!name || isNaN(quantity) || quantity < 0 || isNaN(price) || price <= 0) {
        showToast('Veuillez remplir correctement tous les champs.', 'warning');
        return;
      }
      const newProduct = {
        id: Date.now(),
        name,
        quantity,
        price
      };
      products.unshift(newProduct);
      // Réinitialisation du formulaire
      nameInput.value = '';
      qtyInput.value = '';
      priceInput.value = '';
      nameInput.focus();
      updateStats();
      renderInventory();
      showToast(`📦 "${name}" ajouté au stock (${quantity} unité${quantity > 1 ? 's' : ''})`, 'success');
    });
    // Recherche en temps réel
    document.getElementById('search-input').addEventListener('input', function(e) {
      searchQuery = e.target.value;
      renderInventory();
    });
    // --- 7. INITIALISATION AU CHARGEMENT ---
    document.addEventListener('DOMContentLoaded', () => {
      updateStats();
      renderInventory();
    });
  </script>
</body>
</html>